    {
        "id": "func_max_potencia",
        "type": "function",
        "z": "tab_csv_analisis",
        "name": "a) Potencia maxima",
        "func": "// msg.payload es un array con un objeto por fila del CSV\nconst filas = msg.payload;\n\n// Busca la columna 'potencia' (el encabezado puede traer espacios)\nconst clave = Object.keys(filas[0]).find(k => k.trim() === \"potencia\");\n\nlet maximo = -Infinity;\nlet instante = \"\";\n\nfor (const fila of filas) {\n    const valor = parseFloat(fila[clave]);\n    if (!isNaN(valor) && valor > maximo) {\n        maximo = valor;\n        instante = fila.timestamp;\n    }\n}\n\nmsg.payload = maximo;\nmsg.topic = \"Potencia maxima [W]\";\nmsg.instante = instante;\nnode.status({ fill: \"green\", shape: \"dot\", text: \"Max: \" + maximo + \" W\" });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 120,
        "wires": [
            [
                "debug_max"
            ]
        ]
    },
    {
        "id": "func_prom_corriente",
        "type": "function",
        "z": "tab_csv_analisis",
        "name": "b) Corriente promedio",
        "func": "// msg.payload es un array con un objeto por fila del CSV\nconst filas = msg.payload;\n\n// Busca la columna 'corriente' (el encabezado puede traer espacios)\nconst clave = Object.keys(filas[0]).find(k => k.trim() === \"corriente\");\n\nlet suma = 0;\nlet cantidad = 0;\n\nfor (const fila of filas) {\n    const valor = parseFloat(fila[clave]);\n    if (!isNaN(valor)) {\n        suma += valor;\n        cantidad++;\n    }\n}\n\nconst promedio = cantidad > 0 ? suma / cantidad : 0;\n\nmsg.payload = Number(promedio.toFixed(3));\nmsg.topic = \"Corriente promedio [A]\";\nmsg.muestras = cantidad;\nnode.status({ fill: \"blue\", shape: \"dot\", text: \"Prom: \" + msg.payload + \" A\" });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 200,
        "wires": [
            [
                "debug_prom"
            ]
        ]
    },
