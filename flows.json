    {
        "id": "sf_func",
        "type": "function",
        "z": "sf_timestamp",
        "name": "Generar timestamp",
        "func": "// Formatea la fecha/hora local como \"YYYY-MM-DD HH:mm:ss\"\nconst pad = n => String(n).padStart(2, \"0\");\nfunction ahora() {\n    const d = new Date();\n    return d.getFullYear() + \"-\" + pad(d.getMonth() + 1) + \"-\" + pad(d.getDate()) + \" \" +\n           pad(d.getHours()) + \":\" + pad(d.getMinutes()) + \":\" + pad(d.getSeconds());\n}\n\nlet timer = context.get(\"timer\");\n\n// Si llega msg.reset con valor verdadero: detener la generacion\nif (msg.reset) {\n    if (timer) {\n        clearInterval(timer);\n        context.set(\"timer\", null);\n    }\n    node.status({ fill: \"red\", shape: \"ring\", text: \"detenido\" });\n    return null;\n}\n\n// Cualquier otro mensaje: iniciar (si no estaba ya generando)\nif (!timer) {\n    const enviar = () => node.send({ timestamp: ahora() });\n    enviar();                              // primer timestamp inmediato\n    timer = setInterval(enviar, 1000);     // luego cada 1 segundo\n    context.set(\"timer\", timer);\n    node.status({ fill: \"green\", shape: \"dot\", text: \"generando\" });\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "// Al hacer Deploy o detener Node-RED, limpiar el temporizador\nconst timer = context.get(\"timer\");\nif (timer) clearInterval(timer);",
        "libs": [],
        "x": 220,
        "y": 80,
        "wires": [
            []
        ]
    },
    {
        "id": "sf_coils_func",
        "type": "function",
        "z": "sf_coils",
        "name": "Armar pedido FC01",
        "func": "// Lee Address y Quantity desde las propiedades del subflow\nconst address  = Number(env.get(\"ADDRESS\"));\nconst quantity = Number(env.get(\"QUANTITY\"));\n\nif (isNaN(address) || isNaN(quantity) || address < 0 || quantity < 1) {\n    node.error(\"ADDRESS o QUANTITY invalidos\", msg);\n    node.status({ fill: \"red\", shape: \"ring\", text: \"parametros invalidos\" });\n    return null;\n}\n\n// Pedido para el nodo Modbus Flex Getter\nmsg.payload = {\n    fc: 1,              // FC01: Read Coils\n    unitid: 1,          // Slave ID configurado en Modbus Slave\n    address: address,\n    quantity: quantity\n};\nmsg.topic = \"Coils \" + address + \" a \" + (address + quantity - 1);\nnode.status({ fill: \"blue\", shape: \"dot\", text: \"Addr \" + address + \" / Qty \" + quantity });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 200,
        "y": 80,
        "wires": [
            [
                "sf_coils_flex"
            ]
        ]
    },
