    {
        "id": "sf_f_max",
        "type": "function",
        "z": "sf_csv_max",
        "name": "Calcular maximo",
        "func": "// msg.payload es un array con un objeto por fila: msg.payload[0].corriente, etc.\nconst columna = String(env.get(\"COLUMNA\")).trim();\nconst filas = msg.payload;\n\nif (!Array.isArray(filas) || filas.length === 0) {\n    node.error(\"El archivo no tiene datos\", msg);\n    return null;\n}\n\n// Busca la columna ignorando espacios en el encabezado (ej: \"potencia  \")\nconst clave = Object.keys(filas[0]).find(k => k.trim() === columna);\nif (clave === undefined) {\n    node.error(\"La columna '\" + columna + \"' no existe. Columnas: \" + Object.keys(filas[0]).join(\", \"), msg);\n    node.status({ fill: \"red\", shape: \"ring\", text: \"columna no encontrada\" });\n    return null;\n}\n\nlet maximo = -Infinity;\nfor (const fila of filas) {\n    const valor = parseFloat(fila[clave]);\n    if (!isNaN(valor) && valor > maximo) maximo = valor;\n}\n\nmsg.payload = maximo;\nmsg.topic = \"Maximo de \" + columna;\nnode.status({ fill: \"green\", shape: \"dot\", text: columna + \" max: \" + maximo });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 690,
        "y": 160,
        "wires": [
